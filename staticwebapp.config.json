{
  "routes": [
    { "route": "/lp", "rewrite": "/lp.html" },
    { "route": "/links", "rewrite": "/links.html" },
    { "route": "/privacidade", "rewrite": "/privacidade.html" },

    { "route": "/admin*", "allowedRoles": ["editor", "administrator"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/api/*", "allowedRoles": ["editor", "administrator"] },

    { "route": "/content/*", "statusCode": 404 },
    { "route": "/.auth/login/github", "statusCode": 404 },

    {
      "route": "/defesa-alteracoes-lp",
      "rewrite": "/defesa-alteracoes-lp.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/links-embed-builder",
      "rewrite": "/links-embed-builder.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".xml": "application/xml",
    ".txt": "text/plain",
    ".mjs": "text/javascript"
  }
}
